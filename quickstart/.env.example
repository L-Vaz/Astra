# ─────────────────────────────────────────────────────────────
# Rename this file to ".env" and paste your key after the = sign.
# Keep ONLY the provider you're using; delete or ignore the other.
# No quotes, no spaces around the = sign.
# ─────────────────────────────────────────────────────────────

# Anthropic (recommended) — from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# OpenAI — from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-paste-your-key-here
